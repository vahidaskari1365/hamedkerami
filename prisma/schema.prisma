generator client {
  provider = "prisma-client-js"
  /* Engines for shared hosting (cPanel):
     debian-openssl-1.0.x = current IranHost host (Debian + OpenSSL 1.0)
     rhel-openssl-1.0.x / rhel-openssl-3.0.x = CloudLinux / AlmaLinux
     native = CI build machine */
  binaryTargets = ["native", "debian-openssl-1.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String?
  createdAt DateTime @default(now())
}

/* ---------- نوبت‌دهی آنلاین ---------- */
model Appointment {
  id            String   @id @default(cuid())
  name          String // نام بیمار
  phone         String
  doctor        String // دکتر انتخابی
  dayIso        String // روز انتخابی — ISO میلادی «2026-11-08» برای مرتب‌سازی
  dayJalali     String // همان روز به شمسی «یکشنبه ۱۷ آبان ۱۴۰۵» — نمایش در پنل
  slot          String   @default("") // بازه ساعت دلخواه
  note          String   @default("")
  status        String   @default("pending") // pending | confirmed | done | canceled
  /* ---------- فاز ۲ — رزرو با تأیید پیامکی ---------- */
  latinName     String   @default("") // نام لاتین پرونده
  gender        String   @default("") // female | male
  birthYear     String   @default("") // سال تولد شمسی «۱۳۸۵»
  visitType     String   @default("in_person") // in_person | online
  feeToman      Int      @default(0) // تعرفه ویزیت در لحظه ثبت (اسنپ‌شات)
  paymentMethod String   @default("clinic") // clinic | online
  trackingCode  String   @default("") // کد رهگیری «KB-XXXXXX»
  createdAt     DateTime @default(now())

  @@index([dayIso])
  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([trackingCode])
}

/* کد یک‌بارمصرف تأیید شماره موبایل — ۵ رقمی، هش‌شده ذخیره می‌شود */
model OtpCode {
  id         String    @id @default(cuid())
  mobile     String
  codeHash   String // sha256(mobile:code:secret) — کد خام هرگز ذخیره نمی‌شود
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  ip         String    @default("")
  createdAt  DateTime  @default(now())

  @@index([mobile])
  @@index([createdAt])
}

/* پیام‌های اپراتور/بیمار — تا وصل‌شدن پنل SMS در صف می‌مانند */
model BookingNotification {
  id        String    @id @default(cuid())
  bookingId String    @default("")
  kind      String // operator_sms | patient_sms
  to        String // شماره گیرنده
  body      String
  status    String    @default("queued") // queued | sent | failed
  error     String    @default("")
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status])
  @@index([bookingId])
}

/* ---------- نظرات مقاله‌ها (مدیریت‌شده) ---------- */
model ArticleComment {
  id        String   @id @default(cuid())
  slug      String // اسلاگ مقاله
  name      String
  body      String
  approved  Boolean  @default(false) // فقط تأییدشده‌ها در سایت نمایش داده می‌شوند
  createdAt DateTime @default(now())

  @@index([slug])
  @@index([approved])
}

/* ---------- ادمین ---------- */
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/* تنظیمات متنی سایت — key/value با مقدار JSON */
model Setting {
  key   String @id
  value String
}

/* ---------- آمار بازدید ---------- */
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String   @default("")
  device    String   @default("desktop") // desktop | mobile | tablet
  browser   String   @default("")
  sessionId String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

/* ---------- محتوای سایت ---------- */
model Service {
  id        String  @id @default(cuid())
  slug      String  @default("")
  title     String
  latin     String  @default("")
  desc      String  @default("")
  image     String  @default("")
  points    String  @default("[]") // JSON: array of strings
  order     Int     @default(0)
  published Boolean @default(true)
}

model ServiceExtra {
  id    String @id @default(cuid())
  title String
  desc  String @default("")
  order Int    @default(0)
}

model Education {
  id    String @id @default(cuid())
  year  String
  title String
  place String @default("")
  order Int    @default(0)
}

model TeamMember {
  id    String  @id @default(cuid())
  name  String
  role  String  @default("")
  image String  @default("")
  order Int     @default(0)
}

model Stat {
  id     String @id @default(cuid())
  value  Int    @default(0)
  label  String
  suffix String @default("")
  order  Int    @default(0)
}

model SuccessRate {
  id     String @id @default(cuid())
  rate   String
  title  String
  detail String @default("")
  order  Int    @default(0)
}

model CostItem {
  id       String @id @default(cuid())
  category String @default("jaw") // jaw | implant
  item     String
  price    String
  order    Int    @default(0)
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String   @default("")
  body      String   @default("")
  cover     String   @default("")
  date      String   @default("")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryCase {
  id    String @id @default(cuid())
  src   String
  cat   String @default("")
  title String @default("")
  order Int    @default(0)
}

model PortfolioCover {
  id    String @id @default(cuid())
  src   String
  title String @default("")
  order Int    @default(0)
}

model Certificate {
  id    String @id @default(cuid())
  src   String
  title String @default("")
  order Int    @default(0)
}

model Faq {
  id    String @id @default(cuid())
  q     String
  a     String @default("")
  order Int    @default(0)
}

model Hour {
  id     String @id @default(cuid())
  day    String
  doctor String @default("")
  time   String @default("")
  order  Int    @default(0)
}

model BeforeAfterPair {
  id     String @id @default(cuid())
  key    String @unique // bimax | blepharo | main
  before String
  after  String
  label  String @default("")
}

/* ---------- صفحات فرود سئو (قابل ویرایش از پنل) ---------- */
model LandingPage {
  id              String   @id @default(cuid())
  slug            String   @unique // jaw-surgery | chin-surgery | dental-implant | implant-pasdaran
  label           String // نام نمایشی در پنل
  metaTitle       String   @default("")
  metaDescription String   @default("")
  keywords        String   @default("[]") // JSON: string[]
  eyebrow         String   @default("")
  h1              String   @default("")
  heroDesc        String   @default("")
  heroImage       String   @default("")
  heroImageAlt    String   @default("")
  sections        String   @default("[]") // JSON: [{title, paragraphs[], cards[{title,desc}], steps[], bullets[]}]
  ctaTitle        String   @default("")
  ctaDesc         String   @default("")
  faqs            String   @default("[]") // JSON: [{q,a}]
  related         String   @default("[]") // JSON: [{href,label}]
  published       Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}
